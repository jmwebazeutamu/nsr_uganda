# Copy to .env for local development. .env is gitignored.
#
# These dev-default values are the same ones apps.security.checks fails
# closed against, so you can switch DEBUG=False here to verify the
# production checks fire.

DEBUG=True
DJANGO_SECRET_KEY=dev-only-replace-before-deploy
ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite fallback for the dev loop. For the docker-compose flow, use:
#   DATABASE_URL=postgres://nsr:nsr@db:5432/nsr
# DATABASE_URL=

# Column-level secrets for NIN encryption + join hashing. The values
# below are the public dev defaults — DO NOT use in production.
# Production deploys must read these from the NITA-U KMS or secrets
# manager (per ADR-0002 and DPIA §8).
NSR_NIN_PEPPER=dev-only-nin-pepper-replace-before-deploy
NSR_DATA_KEY=6kZf3vUYNDxBcLg3Vh-uYqOjQp4mEX0sIqAJ8u3OZk0=

# Email / SMTP. The app prefers SMTP automatically when host/user/
# password are present; otherwise it falls back to the console backend
# for dev/CI. To force a specific backend, set EMAIL_BACKEND
# explicitly. The quasar.ug relay is the same one the comms
# rental_project uses; the production password lives in the secrets
# manager, NEVER in this file.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=comms.quasar.ug
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=admin@quasar.ug
EMAIL_HOST_PASSWORD=replace-with-secret-from-secrets-manager
DEFAULT_FROM_EMAIL=NSR MIS <admin@quasar.ug>

# ---------------------------------------------------------------------
# Full variable catalogue
# ---------------------------------------------------------------------
# The names below are read by nsr_mis/settings.py and
# nsr_mis/email_settings.py but are left unset in dev, where the
# built-in defaults are correct. They are listed here so the complete
# set is discoverable from one file. For production values and the
# reasoning behind each, see .env.production.example — that is the
# authoritative template for nsr-sris.mglsd.go.ug.
#
# Deployment (production only; meaningless in dev):
#   NSR_IMAGE          pinned app image tag, never :latest
#   NGINX_CONF         which nginx vhost is live (http vs ssl)
#   PUBLIC_HOST        hostname used by the nginx healthcheck
#
# Security / transport:
#   NSR_SECURE_SSL     secure cookies + HSTS + proxy ssl header
#   CSRF_TRUSTED_ORIGINS   https origin(s) allowed to POST
#   NSR_WHITENOISE     serve /static from gunicorn
#   NSR_ENFORCE_DATA_PERMISSIONS   ADR-0028 permission enforcement
#   NSR_PUBLIC_API_DOCS    unauthenticated /api/docs/
#
# Database:
#   DATABASE_URL, DATABASE_URL_ANALYTICS
#   POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB   (container only)
#
# Celery:
#   CELERY_ENABLED, CELERY_TASK_ALWAYS_EAGER,
#   CELERY_BROKER_URL, CELERY_RESULT_BACKEND
#
# File-backed stores (directories are set in compose for production):
#   DRS_BUNDLE_STORAGE / DRS_BUNDLE_DIR
#   UPD_EVIDENCE_STORAGE / UPD_EVIDENCE_DIR
#   CONSENT_EVIDENCE_STORAGE / CONSENT_EVIDENCE_DIR
#   MEDIA_ROOT, STATIC_ROOT
#
# Feature flags:
#   CONSENT_MODULE_ENABLED, DQA_INTRA_HOUSEHOLD_ENABLED,
#   DATA_EXPLORER_ENABLED, DATA_EXPLORER_SKIP_STARTUP_REFRESH,
#   CHATBOT_ENABLED, CHATBOT_MODEL, CHATBOT_EMBEDDER,
#   DQA_RULE_EDITOR_V2, NSR_PUBLIC_STATS_LIVE
#
# Routing / misc:
#   ROOT_URLCONF       swapped to nsr_mis.urls_public for the public site
#   NSR_STAFF_SIGNIN_URL, DPO_EMAIL, SLACK_WEBHOOK_URL,
#   ANTHROPIC_API_KEY, NIRA_PROVIDER,
#   DRS_DOWNLOAD_THROTTLE_RATE, DATA_UPLOAD_MAX_MEMORY_SIZE
