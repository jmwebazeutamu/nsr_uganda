# NSR MIS — PRODUCTION environment template (nsr-sris.mglsd.go.ug).
#
# Copy to /opt/nsrmis/.env ON THE SERVER, fill in every CHANGE_ME, then:
#   chmod 600 /opt/nsrmis/.env
#
# NEVER commit the filled-in file. NEVER paste its values into a ticket,
# a chat message or a CI log. This file is the only version that belongs
# in git, and it must stay value-free.
#
# The training/testing box (nsr-sris-dev.quasar.ug) uses a different
# template: .env.prod.example. Do not mix them up — that one assumes a
# host Apache owns TLS; this one runs nginx inside the stack.
#
# Generate the three secrets ON THE SERVER:
#   DJANGO_SECRET_KEY : python3 -c "import secrets;print(secrets.token_urlsafe(64))"
#   NSR_NIN_PEPPER    : python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#   NSR_DATA_KEY      : python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#
# ⚠ NSR_NIN_PEPPER and NSR_DATA_KEY are NOT free choices once data
# exists. They decrypt the NIN column and produce nin_hash. If production
# is restored from a dev dump (Phase 6), these MUST be the SAME values
# dev used, or every encrypted NIN becomes unreadable and every hash
# join breaks. Change them only with a planned re-encryption migration.

# ── deployment ─────────────────────────────────────────────────────────
# Pinned image tag. NO :latest. The deploy workflow rewrites this line to
# the commit SHA it just built; to roll back, set it to an older SHA and
# re-run `docker compose -f compose.production.yml --env-file .env up -d`.
NSR_IMAGE=ghcr.io/jmwebazeutamu/nsr_uganda:CHANGE_ME_commit_sha

# Which nginx config is live. Phase 5 boots HTTP-only; Phase 7 switches
# this to nsr-sris.ssl.conf AFTER certbot has issued the certificate.
# Setting it to the ssl config before a cert exists stops nginx booting.
NGINX_CONF=nsr-sris.http.conf

# Used by the nginx container healthcheck's Host header.
PUBLIC_HOST=nsr-sris.mglsd.go.ug

# ── core Django ────────────────────────────────────────────────────────
DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_generate_on_the_server

# localhost/127.0.0.1 must stay: the container healthcheck curls
# localhost:8000/healthz. nginx proxies with the real Host header.
ALLOWED_HOSTS=nsr-sris.mglsd.go.ug,localhost,127.0.0.1

# Sets SECURE_PROXY_SSL_HEADER, SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE
# and HSTS. Keep True from Phase 7 onward. During the Phase 5 HTTP-only
# bring-up leave it False, or secure cookies will be refused over http://
# and you will not be able to sign in.
NSR_SECURE_SSL=False

# Must be https:// and must match the browser origin exactly, or every
# POST from the console fails CSRF. Set once TLS is live.
CSRF_TRUSTED_ORIGINS=https://nsr-sris.mglsd.go.ug

# WhiteNoise serves /static from inside gunicorn for both containers.
NSR_WHITENOISE=True

# ── database ───────────────────────────────────────────────────────────
# POSTGRES_* create the database inside the db container; DATABASE_URL is
# how Django connects. They MUST agree — same user, same password, same
# db name — or the app starts against a database that does not exist.
# Host is `db` (the compose service name) and NOT a host port: the
# database is never published outside the backend network.
POSTGRES_USER=CHANGE_ME_db_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=CHANGE_ME_db_name
DATABASE_URL=postgres://CHANGE_ME_db_user:CHANGE_ME_strong_db_password@db:5432/CHANGE_ME_db_name
# No read replica yet — point the analytics alias at the same database.
DATABASE_URL_ANALYTICS=postgres://CHANGE_ME_db_user:CHANGE_ME_strong_db_password@db:5432/CHANGE_ME_db_name

# ── column-level crypto (apps.security.checks fails closed without these
#    once DEBUG=False) ───────────────────────────────────────────────────
NSR_NIN_PEPPER=CHANGE_ME_must_match_dev_if_restoring_dev_data
NSR_DATA_KEY=CHANGE_ME_must_match_dev_if_restoring_dev_data

# ── Celery ─────────────────────────────────────────────────────────────
# Real worker + beat in production, so tasks must NOT run eagerly.
CELERY_ENABLED=True
CELERY_TASK_ALWAYS_EAGER=False
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── file-backed stores ─────────────────────────────────────────────────
# `file` keeps these on disk. The DIRECTORIES are set in
# compose.production.yml (not here) so they cannot drift from the named
# volumes that persist them. Switch to MinIO when the bucket lands.
DRS_BUNDLE_STORAGE=file
UPD_EVIDENCE_STORAGE=file
CONSENT_EVIDENCE_STORAGE=file

# ── feature flags ──────────────────────────────────────────────────────
# Consent stays OFF until DPO sign-off (ADR-0024).
CONSENT_MODULE_ENABLED=False
DQA_INTRA_HOUSEHOLD_ENABLED=True
DATA_EXPLORER_ENABLED=True
CHATBOT_ENABLED=False
# Form-based DQA Rule Editor (US-076). Defaults to DEBUG, so it is off in
# production unless switched on deliberately.
DQA_RULE_EDITOR_V2=False
# Unauthenticated /api/schema/ + /api/docs/. Keep False on a production
# registry; turning it on is a threat-model decision (partner portal).
NSR_PUBLIC_API_DOCS=False
# Public-site figures stay OFF until the DPO signs the §8.3 disclosure
# floor (LP-O-06); the page renders placeholder slots meanwhile.
NSR_PUBLIC_STATS_LIVE=False
# Enforce the eight TOR data permissions (ADR-0028). Never False in prod.
NSR_ENFORCE_DATA_PERMISSIONS=True

# ── email ──────────────────────────────────────────────────────────────
# The app picks SMTP automatically when host/user/password are all set,
# otherwise it falls back to the console backend. Set these or
# notification mail silently goes nowhere.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=CHANGE_ME_smtp_host
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=CHANGE_ME_smtp_user
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DEFAULT_FROM_EMAIL=NSR MIS <CHANGE_ME_from_address>

# ── routing / links ────────────────────────────────────────────────────
# Relative, so the link survives a hostname change. Same origin: nginx
# path-routes /login/ to the registry container.
NSR_STAFF_SIGNIN_URL=/login/

# ── optional integrations (leave commented if unused) ──────────────────
# DPO_EMAIL=CHANGE_ME_dpo_address
# SLACK_WEBHOOK_URL=CHANGE_ME_webhook
# ANTHROPIC_API_KEY=CHANGE_ME_api_key
# NIRA_PROVIDER=mock
# CHATBOT_MODEL=CHANGE_ME_model_id
# CHATBOT_EMBEDDER=CHANGE_ME_embedder
# DRS_DOWNLOAD_THROTTLE_RATE=CHANGE_ME_rate
# DATA_EXPLORER_SKIP_STARTUP_REFRESH=False
