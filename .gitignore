.ruff_cache/

# Misc
*.pid
*.sock

# Node (Vitest + RTL — see package.json)
node_modules/
.vitest-cache/

# Design — local scratch backups (e.g. partners-source/, screens-source/)
design/v0.1/*-source/

# DRS bundle store (file-backed default) — local-only artefacts;
# regenerated on demand via /render-and-deliver/ + the download
# endpoint's lazy-regen path.
.drs-bundles/

# Open-CR evidence files (file-backed default) — operator uploads
# attached to ChangeRequests. Content-addressable; production uses
# MinIO once the bucket lands.
.upd-evidence/

# MkDocs build output for the user manual
/docs/user-manual/site/

# --- Production / deployment hygiene (Phase 2, prod setup) ------------
# Local compose overrides are per-machine and MUST NOT reach a server:
# compose auto-loads this file, so a committed one would silently apply
# dev port mappings and the arm64 postgis image on production.
docker-compose.override.yml
compose.override.yml

# Env files. .env is already covered above; these are the sibling forms
# that have appeared on dev boxes. *.example templates stay tracked.
.ci-test.env
.env.prod
.env.production
*.env
!.env.example
!.env.prod.example
!.env.production.example

# Data migration working area (dumps, archives, checksums). Never
# committed — these contain live personal data under the DPPA 2019.
migration/
*.sql
*.sql.gz
*.dump
*.tar.gz
*.tgz
!docs/**/*.sql

# Consent evidence (file-backed default), sibling of .upd-evidence/
.consent-evidence/

# Backups
backups/
*.bak

# Operator console — GENERATED output only (scripts/build_console.mjs).
# Committing 47 minified files would put a build artefact in every diff.
#
# static/console/vendor/ and static/console/fonts/ are NOT ignored: they
# are third-party sources (d3, React UMD, Inter), not build products.
# The image build has no network, so if they were not committed the
# console would 404 on every one of them in CI.
static/console/js/
static/console/manifest.json
static/console/manifest-admin.json
static/console/assets/
static/console/console.css
static/console/maps/
