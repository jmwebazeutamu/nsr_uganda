# Heavy directories the runtime image does not need.
#
# design/ is NOT excluded: the console build stage compiles its JSX. It
# still never reaches the runtime image — only static/console/, the
# compiled output, is COPYd from the build stage. Excluding it here is
# what made /console/ 404 in production, because the view fell back to
# serving files that were not in the image.
docs
tests
.claude
# Exclude the heavy infra subdirs but KEEP infrastructure/docker/ — the
# Dockerfile COPYs web-entrypoint.sh from there.
infrastructure/helm
infrastructure/terraform
infrastructure/runbooks

# Build artefacts
dist
build
