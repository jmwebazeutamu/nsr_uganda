{
  "realm": "nsr-mis",
  "displayName": "NSR MIS (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "bruteForceProtected": true,
  "failureFactor": 3,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,

  "roles": {
    "realm": [
      { "name": "NSR_UNIT_COORDINATOR", "description": "National coordinator. is_superuser + NATIONAL scope." },
      { "name": "DPO", "description": "Data Protection Officer. NATIONAL scope + is_staff; reads across geographies, does not write." },
      { "name": "SA", "description": "System administrator. is_superuser; bypasses ABAC." },
      { "name": "CDO", "description": "Community Development Officer. DISTRICT scope + GRM L2." },
      { "name": "PARISH_CHIEF", "description": "PARISH scope + GRM L1." },
      { "name": "FIELD_ENUMERATOR", "description": "PARISH scope; submits but cannot approve." },
      { "name": "DISTRICT_M_AND_E", "description": "DISTRICT scope; routed for UPD escalation." },
      { "name": "PARTNER_ANALYST", "description": "PARTNER scope (scope_code = Partner.code); own DSAs and DataRequests." },
      { "name": "PARTNER_DPO", "description": "PARTNER scope + is_staff; read-only across the partner's own data." },
      { "name": "connector:write", "description": "Service accounts only. DIH connector write access." }
    ]
  },

  "clients": [
    {
      "clientId": "nsr-mis-web",
      "name": "NSR MIS console + admin (Django server-side OIDC client)",
      "description": "Confidential: Django runs the code exchange and issues its own session. ADR-0006 said public+PKCE; see the runbook for why this is confidential.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "dev-only-nsr-mis-web-secret",
      "redirectUris": [
        "http://localhost:8004/oidc/callback/",
        "http://localhost:8005/oidc/callback/",
        "http://127.0.0.1:8004/oidc/callback/",
        "http://127.0.0.1:8005/oidc/callback/",
        "http://192.168.*/oidc/callback/"
      ],
      "webOrigins": [
        "http://localhost:8004",
        "http://localhost:8005",
        "http://192.168.*"
      ],
      "protocolMappers": [
        {
          "name": "geographic_codes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "geographic_codes",
            "claim.name": "geographic_codes",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "partner_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "partner_code",
            "claim.name": "partner_code",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nsr-mis-api",
      "name": "NSR MIS backend (service-to-service / token introspection)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-only-nsr-mis-api-secret"
    },
    {
      "clientId": "nsr-mis-capi",
      "name": "CAPI tablets (public, PKCE + device flow)",
      "description": "Device flow lets the offline tablet UI bootstrap an operator without a browser.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "redirectUris": ["http://localhost:*/*", "nsrmis://oidc/callback"]
    },
    {
      "clientId": "nsr-mis-connector-pdm",
      "name": "DIH connector service account — PDM",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-only-connector-pdm-secret"
    },
    {
      "clientId": "nsr-mis-connector-nusaf",
      "name": "DIH connector service account — NUSAF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-only-connector-nusaf-secret"
    },
    {
      "clientId": "nsr-mis-connector-wfp",
      "name": "DIH connector service account — WFP",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-only-connector-wfp-secret"
    },
    {
      "clientId": "nsr-mis-connector-nira",
      "name": "DIH connector service account — NIRA (reverse push)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-only-connector-nira-secret"
    }
  ],

  "users": [
    {
      "username": "dev-coordinator",
      "enabled": true,
      "emailVerified": true,
      "email": "dev-coordinator@example.invalid",
      "firstName": "Dev",
      "lastName": "Coordinator",
      "credentials": [
        { "type": "password", "value": "dev-only-password", "temporary": false }
      ],
      "realmRoles": ["NSR_UNIT_COORDINATOR"],
      "attributes": { "geographic_codes": ["national:"] }
    },
    {
      "username": "dev-parish-chief",
      "enabled": true,
      "emailVerified": true,
      "email": "dev-parish-chief@example.invalid",
      "firstName": "Dev",
      "lastName": "ParishChief",
      "credentials": [
        { "type": "password", "value": "dev-only-password", "temporary": false }
      ],
      "realmRoles": ["PARISH_CHIEF"],
      "attributes": { "geographic_codes": ["parish:A-P"] }
    }
  ]
}
